<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/open_tv_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:orientation="vertical">
            <TextView android:id="@+id/app_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OpenTV · API 21" android:textColor="@color/open_tv_text" android:textSize="22sp" android:textStyle="bold" />
            <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:background="#000000" app:show_buffering="when_playing" app:show_timeout="2500" />
            <TextView android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="等待选择频道" android:textColor="@color/open_tv_text" android:textSize="16sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <EditText android:id="@+id/source_input" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="@string/source_hint" android:imeOptions="actionDone" android:inputType="textUri" android:padding="10dp" android:textColor="@color/open_tv_text" android:textColorHint="@color/open_tv_muted" />
                <Button android:id="@+id/load_button" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/load_source" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="16dp" android:layout_weight="1" android:background="@color/open_tv_surface" android:orientation="vertical" android:padding="10dp">
            <EditText android:id="@+id/search_input" android:layout_width="match_parent" android:layout_height="44dp" android:hint="@string/search_hint" android:imeOptions="actionSearch" android:inputType="text" android:padding="8dp" android:textColor="@color/open_tv_text" android:textColorHint="@color/open_tv_muted" />
            <TextView android:id="@+id/empty_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/empty_channels" android:textColor="@color/open_tv_muted" android:textSize="14sp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/channel_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
